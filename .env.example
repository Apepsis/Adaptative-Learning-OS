# Copy this file to .env and fill in real values before running `make dev`.
# Never commit the real .env file.

# --- App ---
APP_ENV=development
APP_SECRET=change-me-to-a-random-secret
LOCAL_SINGLE_USER=true
LOCAL_SINGLE_USER_EMAIL=you@example.com

# --- Database ---
POSTGRES_DB=learning_os
POSTGRES_USER=learning
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://learning:change-me@postgres:5432/learning_os

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally, S3/R2-compatible in the cloud) ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_PREVIEWS=previews
S3_REGION=local
S3_USE_SSL=false

# --- Uploads ---
MAX_UPLOAD_MB=500
MAX_PDF_PAGES=3000
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,image/webp

# --- AI / retrieval ---
# Embeddings run locally (BGE-M3, first-use downloads ~2GB) and need no key.
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_DIMENSION=1024

# Generation (Notebook chat, Phase 3+) needs a Gemini API key —
# https://aistudio.google.com/apikey. Free tier works, but Google may use
# free-tier content to improve products; the paid tier does not
# (blueprint section 2.4). Leave GEMINI_API_KEY blank to disable chat.
AI_PROVIDER=gemini
GEMINI_API_KEY=
FAST_MODEL=gemini-2.5-flash
REASONING_MODEL=gemini-2.5-pro
VISION_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# --- Feature flags ---
ENABLE_MINERU=false
ENABLE_GEMINI_MULTIMODAL_EMBEDDING=false
ENABLE_IRT=false
ENABLE_NEO4J=false
ENABLE_AUDIO_OVERVIEW=false

# --- Planner (not used before Phase 8) ---
PLANNER_FREEZE_HOURS=24
PLANNER_STABILITY_DAYS=7
TARGET_RETENTION=0.90

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
